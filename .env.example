# ==========================================
# SERVER CONFIGURATION
# ==========================================
PORT=3000
NODE_ENV=development

# ==========================================
# DATABASE (PostgreSQL 16 + pgvector)
# ==========================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/rag_creator_platform?schema=public"

# ==========================================
# REDIS / BULLMQ CONFIGURATION
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==========================================
# AUTHENTICATION (JWT)
# ==========================================
JWT_SECRET=super_secret_jwt_key_for_rag_creator_platform_at_least_32_chars
JWT_EXPIRES_IN=7d

# ==========================================
# AI / LLM / EMBEDDING CONFIGURATION
# ==========================================
OPENAI_API_KEY=gsk_placeholder_api_key_or_openai_key
OPENAI_BASE_URL=https://api.groq.com/openai/v1
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=openai/gpt-oss-20b

# ==========================================
# BUSINESS / MONETIZATION CONFIGURATION
# ==========================================
PLATFORM_COMMISSION_PERCENT=20

# ==========================================
# XENDIT PAYMENT GATEWAY CONFIGURATION
# ==========================================
XENDIT_SECRET_KEY=xnd_development_placeholder_key_here
XENDIT_WEBHOOK_VERIFICATION_TOKEN=rag_xendit_webhook_token_secret
XENDIT_SUCCESS_REDIRECT_URL=http://localhost:3000/billing/success
XENDIT_FAILURE_REDIRECT_URL=http://localhost:3000/billing/failed
