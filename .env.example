# ==========================================
# SERVER CONFIGURATION
# ==========================================
PORT=3000
NODE_ENV=development

# ==========================================
# DATABASE (PostgreSQL 16 + pgvector)
# ==========================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/rag_creator_platform?schema=public"

# ==========================================
# REDIS / BULLMQ CONFIGURATION
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==========================================
# AUTHENTICATION (JWT)
# ==========================================
JWT_SECRET=super_secret_jwt_key_for_rag_creator_platform_at_least_32_chars
JWT_EXPIRES_IN=7d

# ==========================================
# AI / LLM / EMBEDDING CONFIGURATION
# ==========================================
# AI runs in the user browser by default. Set AI_EXECUTION=server to opt into backend inference.
AI_EXECUTION=browser
# Browser inference is attempted first; its final AI fallback runs on the server.
SERVER_FALLBACK_PROVIDER=ollama
SERVER_FALLBACK_MODEL=qwen3:1.7b
# Primary server-only providers apply when AI_EXECUTION=server.
LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen3:1.7b
OLLAMA_EMBEDDING_MODEL=embeddinggemma

# Optional OpenAI-compatible API (set LLM_PROVIDER=openai to opt in)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Optional API embedding (set EMBEDDING_PROVIDER=openai to opt in)
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini

# ==========================================
# BUSINESS / MONETIZATION CONFIGURATION
# ==========================================
PLATFORM_COMMISSION_PERCENT=20

# ==========================================
# XENDIT PAYMENT GATEWAY CONFIGURATION
# ==========================================
XENDIT_SECRET_KEY=xnd_development_placeholder_key_here
XENDIT_WEBHOOK_VERIFICATION_TOKEN=rag_xendit_webhook_token_secret
XENDIT_SUCCESS_REDIRECT_URL=http://localhost:3000/billing/success
XENDIT_FAILURE_REDIRECT_URL=http://localhost:3000/billing/failed
